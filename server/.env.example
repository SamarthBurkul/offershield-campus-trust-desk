# OfferShield API configuration. Copy to .env for local development:
#   Copy-Item server\.env.example server\.env
# Never commit .env. All values below are safe placeholders.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# Comma-separated list of browser origins allowed by CORS (scheme://host[:port], no trailing slash)
CLIENT_ORIGINS=http://localhost:5173

# Baseline rate limit for /api: max requests per IP per window (milliseconds)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# MongoDB connection string. Required in development and production (tests use an in-memory server).
MONGODB_URI=mongodb://localhost:27017/offershield

# JWT signing secret, at least 32 random characters. Required in development and production.
# Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-chars

# Session lifetime: whole number + s|m|h|d. Also sets the cookie max-age.
JWT_EXPIRES_IN=8h

# Stricter limit for POST /auth/login and POST /auth/register (per IP per window)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Seed scripts only (npm run seed:superadmin / seed:demo -w server) ---
# Passwords need 10+ characters with at least one letter and one number.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password-1
SEED_DEMO_PASSWORD=replace-with-a-demo-password-1
