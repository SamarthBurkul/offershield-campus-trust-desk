# OfferShield API configuration. Copy to .env for local development:
#   Copy-Item server\.env.example server\.env
# Never commit .env. All values below are safe placeholders.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# Comma-separated list of browser origins allowed by CORS (scheme://host[:port], no trailing slash)
CLIENT_ORIGINS=http://localhost:5173

# Baseline rate limit for /api (window in milliseconds). Signed-in requests count per user
# (many students share one campus IP); anonymous requests count per IP.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
API_USER_RATE_LIMIT_MAX=600

# Proxy hops to trust for the client IP (X-Forwarded-For). 0 locally; defaults to 1 in production (Render).
# TRUST_PROXY=0

# MongoDB connection string. Required in development and production (tests use an in-memory server).
MONGODB_URI=mongodb://localhost:27017/offershield

# JWT signing secret, at least 32 random characters. Required in development and production.
# Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-chars

# Session lifetime: whole number + s|m|h|d. Also sets the cookie max-age.
JWT_EXPIRES_IN=8h

# POST /auth/login: max attempts per IP + email, and per IP, within the window
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_IP_RATE_LIMIT_MAX=200

# POST /auth/register: max attempts per IP within the window (default one hour)
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=60

# Student verification requests: max new requests per student per hour
CASE_CREATE_LIMIT_PER_HOUR=10

# Recruiter registry: default verification validity in days (30-730)
RECRUITER_VERIFICATION_DAYS=365

# Related-case linking: max SimHash Hamming distance (0-32) for "similar text"
SIMHASH_MAX_DISTANCE=6

# Lookup ("check before you pay"): max lookups per user per 10 minutes
LOOKUP_LIMIT_PER_10MIN=60

# An open case with no activity for this many days is marked stale in the staff queue
CASE_STALE_DAYS=3

# Lifetime of a short-lived evidence download link, in seconds (1-3600)
EVIDENCE_LINK_TTL_SECONDS=300

# Public URL of the deployment (scheme://host, no trailing slash), e.g. https://offershield.onrender.com
# APP_BASE_URL=http://localhost:5000

# Contact shown on the privacy notice for deletion requests
# SUPPORT_EMAIL=privacy@your-college.edu

# Evidence of closed cases is deleted after this many months (npm run ops:retention -w server -- --apply)
RETENTION_MONTHS=12

# Demo seeds refuse to run when NODE_ENV=production unless this is true
ALLOW_DEMO_SEED=false

# Development-only: set to false ONLY for a local production smoke on http://localhost (ignored for https).
# COOKIE_SECURE_OVERRIDE=false

# --- Seed scripts only (npm run seed:superadmin / seed:demo -w server) ---
# Passwords need 10+ characters with at least one letter and one number.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password-1
SEED_DEMO_PASSWORD=replace-with-a-demo-password-1
